# Copie este arquivo para .env e preencha os valores antes de rodar
# docker-compose up

# Senha do PostgreSQL local (mude para algo seguro, mesmo em ambiente local)
POSTGRES_PASSWORD=changeme_local_only

# Senha do painel Grafana
GRAFANA_PASSWORD=changeme_local_only

# Chave da API da Anthropic — sem ela, o agent-runtime funciona em
# "modo simulado" (respostas determinísticas, sem custo, úteis para
# testar o pipeline, mas sem raciocínio real de IA)
ANTHROPIC_API_KEY=

# Context Compressor (memória de Sessão) — opcional, com padrão sensato
CONTEXT_COMPRESSOR_LIMITE=20
CONTEXT_COMPRESSOR_MANTER=6

# Limite de leitura da Business Memory — opcional
BUSINESS_MEMORY_LIMITE=20

# Poda de contexto do Workflow Engine — opcional
WORKFLOW_CONTEXT_MAX_STEPS=10
WORKFLOW_CONTEXT_MAX_VALOR_CHARS=2000

# Embeddings do Knowledge Base Service — sem isso, roda em modo
# simulado (mecanicamente correto, mas sem significado semântico real)
VOYAGE_API_KEY=

# Integrações externas — deixar em branco até ter parceiros reais
# configurados (ver services/integration-hub/src/connectors/*.js)
CRM_API_URL=
CRM_API_KEY=
ESIGNATURE_API_URL=
